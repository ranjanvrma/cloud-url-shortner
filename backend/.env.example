# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-value

# Database (MySQL on VM3)
DB_HOST=vm3-private-ip
DB_PORT=3306
DB_NAME=url_shortener
DB_USER=url_shortener_app
DB_PASSWORD=change-this-password

# For local development without MySQL, uncomment:
# SQLALCHEMY_DATABASE_URI=sqlite:///dev.db

# Base URL used to build the short link returned to clients (VM1 public entry point)
BASE_URL=http://your-ec2-public-ip

# Short code
SHORT_CODE_LENGTH=7

# Rate limiting (requests per period, per client IP) for the shorten endpoint
RATE_LIMIT_SHORTEN=20 per minute

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
